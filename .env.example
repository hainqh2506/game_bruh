# Copy to .env and edit. .env is gitignored.
# Biến đã export trên shell thắng giá trị trong file này.

# 1 = tab Kho từ (make dev bật sẵn). Pages dùng wrangler.toml / .dev.vars
DOANCHU_DEBUG=0

# Trần process Python (laptop + tunnel / VPS nhỏ)
DOANCHU_MAX_SOLO=40
DOANCHU_MAX_ROOMS=12
DOANCHU_MAX_PLAYERS=8
DOANCHU_MAX_PARTY=40

# Giây: xóa phòng không còn ai kết nối; TTL slot chơi đơn
DOANCHU_ROOM_TTL=2700
DOANCHU_SOLO_TTL=45
